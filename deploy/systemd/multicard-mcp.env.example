# Directory with markdown docs bundled in this repo
MULTICARD_DOCS_DIR=/opt/multicard-mcp/multicard-docs

# Keep it on localhost and reverse-proxy with nginx/caddy if needed
LISTEN_ADDR=127.0.0.1:8080

# Public URL clients reach this server at, used in OAuth discovery metadata
# and authorize/token URLs. Required behind a reverse proxy.
PUBLIC_BASE_URL=https://multicardocs.sukoon.uz

# Demo login shown on the /authorize consent screen (no real user database).
# Only used when GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET below are unset.
OAUTH_DEMO_USER=demo
OAUTH_DEMO_PASSWORD=demo1234

# When both are set, /authorize federates sign-in to Google (real OpenID
# Connect) instead of showing the demo login above. Create these under
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application), with an authorized redirect URI of
# {PUBLIC_BASE_URL}/auth/google/callback. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
